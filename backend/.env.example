# Optional: copy to .env (never commit .env). npm run dev/start load it automatically.
#
# NODE_ENV: npm run dev and npm start set NODE_ENV=development, npm test runs with NODE_ENV=test,
# npm run start:prod sets NODE_ENV=production. If NODE_ENV is missing (or anything other than
# development/test), the API runs as production: no demo users, and JWT_SECRET is required.
PORT=4000
DB_PATH=loan-tracker.db
# Required in production. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me
# Comma-separated list of frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000
# Express "trust proxy". Leave unset (false) unless the API is behind a reverse proxy / load balancer.
# "true" trusts every proxy, a number trusts that many hops (usually 1), or list addresses/subnets
# such as "loopback, 10.0.0.0/8". Needed so the login rate limiter sees the real client IP.
TRUST_PROXY=false
